---
import Base from '../layouts/Base.astro';
import HeroBoard from '../components/HeroBoard.astro';
import { FAQ } from '../utils/faq';
import { PLANS, TESTIMONIALS, FREE_ANALYSES_PER_DAY, TRAINING } from '../config';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'NextGranMaestro', applicationCategory: 'GameApplication', operatingSystem: 'Web', inLanguage: 'es', description: 'Analizador de posiciones de ajedrez en el navegador con el motor Stockfish.' },
];
const trust = [
  { i: '♜', t: 'Motor Stockfish', d: 'Uno de los motores de ajedrez más fuertes del mundo.' },
  { i: '🔒', t: 'Privado', d: 'El análisis corre en tu dispositivo; tus posiciones no se envían.' },
  { i: '⚡', t: 'Sin instalar nada', d: 'Abre la web, coloca la posición y analiza.' },
  { i: '🎯', t: 'Una jugada, una flecha', d: 'La mejor jugada dibujada directamente en el tablero.' },
];
const feats = [
  { i: '♞', t: 'Mejor jugada al instante', d: 'Pulsa «Analizar» y ves la jugada recomendada marcada con una flecha sobre el tablero.' },
  { i: '📈', t: 'Evaluación en tiempo real', d: 'Barra de ventaja y valor numérico para saber quién va mejor y por cuánto.' },
  { i: '🧠', t: 'Entiende el porqué', d: 'La línea principal te enseña las siguientes jugadas para ver la idea detrás.' },
  { i: '♟', t: 'Cualquier posición', d: 'Mueve las piezas a mano o pega una posición en formato FEN.' },
  { i: '📱', t: 'Hecho para móvil', d: 'Tablero táctil rápido y cómodo, también en pantallas pequeñas.' },
  { i: '🔊', t: 'Sonidos opcionales', d: 'Efectos al mover, capturar y dar jaque. Se desactivan con un clic.' },
];
const uses = [
  { t: 'Revisa tus partidas', d: 'Carga una posición crítica y descubre qué jugada era mejor y por qué.' },
  { t: 'Prepara aperturas', d: 'Comprueba qué dice el motor en cada posición de tu repertorio.' },
  { t: 'Entrena táctica', d: 'Pega un problema en FEN y verifica si has visto la mejor continuación.' },
];
import OnlinePulse from '../components/OnlinePulse.astro';
---
<Base title="NextGranMaestro — Analiza tu posición y descubre la mejor jugada" description="Analizador de ajedrez online con motor Stockfish: obtén la mejor jugada dibujada en el tablero, la evaluación y la línea principal de cualquier posición, en tu navegador." jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Análisis de ajedrez con motor</span>
        <h1>Descubre la <em>mejor jugada</em> de cualquier posición</h1>
        <p class="lead">NextGranMaestro analiza tu tablero con Stockfish y dibuja sobre él la mejor jugada, con la evaluación y la línea principal. Estudia tus partidas, corrige tus errores y juega mejor.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/analizador">Probar gratis ahora</a>
          <a class="btn" href="/precios" data-free-only>Ver precios</a>
          <a class="btn" href="/entrenamiento" data-prem-only>Entrenar hoy</a>
        </div>
        <ul class="badges">
          <li>{FREE_ANALYSES_PER_DAY} análisis gratis al día</li><li>Sin registro</li><li data-free-only>Plan ilimitado desde {PLANS.yearly.note.match(/[\d,]+ €\/mes/)?.[0] ?? PLANS.monthly.price}</li>
        </ul>
      </div>
      <HeroBoard />
    </div>
  </section>

  <div class="strip">
    <div class="wrap"><ul>
      {trust.map((x) => <li><span class="si" aria-hidden="true">{x.i}</span><span><b>{x.t}</b>{x.d}</span></li>)}
    </ul></div>
  </div>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Qué incluye</span><h2>Todo lo que necesitas para analizar</h2></div>
      <div class="grid grid-3">
        {feats.map((f) => <article class="card reveal"><div class="ico" aria-hidden="true">{f.i}</div><h3>{f.t}</h3><p class="muted">{f.d}</p></article>)}
      </div>
    </div>
  </section>

  <section>
    <div class="narrow">
      <div class="sec-head reveal"><span class="eyebrow">Así de fácil</span><h2>Tres pasos y listo</h2></div>
      <ol class="steps">
        <li class="reveal"><h3>Coloca la posición</h3><p class="muted">Mueve las piezas en el tablero o pega una posición FEN.</p></li>
        <li class="reveal"><h3>Pulsa «Analizar»</h3><p class="muted">El motor calcula en tu navegador. Tarda unos segundos según la profundidad.</p></li>
        <li class="reveal"><h3>Sigue la flecha</h3><p class="muted">Verás la mejor jugada marcada en el tablero y la línea de juego que la acompaña.</p></li>
      </ol>
      <p style="margin-top:1.5rem;text-align:center"><a href="/como-funciona">Cómo funciona en detalle →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Para qué sirve</span><h2>Hecho para mejorar tu juego</h2></div>
      <div class="grid grid-3">
        {uses.map((u) => <article class="card reveal"><h3>{u.t}</h3><p class="muted">{u.d}</p></article>)}
      </div>
      <div class="notice reveal" style="max-width:760px;margin-inline:auto"><strong>Juego limpio.</strong> NextGranMaestro es una herramienta de estudio y análisis. No la uses durante partidas contra otras personas: incumple las normas de las plataformas y de los torneos.</div>
    </div>
  </section>

  <section>
    <div class="narrow">
      <div class="sec-head reveal"><span class="eyebrow">Entrenamiento</span><h2>Mejora un nivel cada día</h2></div>
      <p class="muted reveal" style="text-align:center;max-width:60ch;margin-inline:auto">Ejercicios de «encuentra la mejor jugada» ordenados de menos a más difícil, en el mismo tablero del analizador. Cada solución está comprobada con Stockfish. Con el plan gratis avanzas {TRAINING.freePerDay} niveles al día<span data-free-only> y con el plan ilimitado, {TRAINING.premiumPerDay}</span>.</p>
      <p style="text-align:center;margin-top:1.2rem"><a class="btn btn-primary" href="/entrenamiento">Ir al entrenamiento</a></p>
    </div>
  </section>

  <section>
    <div class="narrow" style="text-align:center">
      <div class="sec-head reveal"><span class="eyebrow">Online</span><h2>Duelos en línea con ranking Elo</h2></div>
      <p class="muted reveal" style="max-width:60ch;margin-inline:auto">Juega contra otras personas en tiempo real, con tu Elo y un ranking. Verás cuánta gente hay conectada antes de empezar.</p>
      <OnlinePulse />
      <p style="margin-top:.8rem"><a class="btn btn-primary" href="/online">Jugar en línea</a></p>
    </div>
  </section>

  <section>
    <div class="narrow">
      <div class="sec-head reveal"><span class="eyebrow">Jugar</span><h2>Mide tu nivel contra bots</h2></div>
      <p class="muted reveal" style="text-align:center;max-width:60ch;margin-inline:auto">Rivales de 400 a 1700 de Elo aproximado, gratis<span data-free-only>, y bots más fuertes con el plan ilimitado</span>. Tienes 3 pistas por partida.</p>
      <p style="text-align:center;margin-top:1.2rem"><a class="btn btn-primary" href="/jugar">Jugar ahora</a></p>
    </div>
  </section>

  {TESTIMONIALS.length > 0 && (
    <section>
      <div class="wrap">
        <div class="sec-head reveal"><span class="eyebrow">Opiniones</span><h2>Lo que dicen los jugadores</h2></div>
        <div class="testi">
          {TESTIMONIALS.map((t) => <article class="card reveal"><blockquote><p>“{t.text}”</p></blockquote><footer><strong>{t.name}</strong>{t.detail ? ` · ${t.detail}` : ''}</footer></article>)}
        </div>
      </div>
    </section>
  )}

  <section data-free-only>
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Precios</span><h2>Empieza gratis, mejora cuando quieras</h2></div>
      <div class="mini">
        <article class="card reveal"><h3>Gratis</h3><p class="price">0 €</p><p class="muted">{FREE_ANALYSES_PER_DAY} análisis al día</p></article>
        <article class="card reveal"><h3>Mensual</h3><p class="price">{PLANS.monthly.price}<small>{PLANS.monthly.period}</small></p><p class="muted">Análisis ilimitados</p></article>
        <article class="card featured reveal"><h3>Anual</h3><p class="price">{PLANS.yearly.price}<small>{PLANS.yearly.period}</small></p><p class="muted">{PLANS.yearly.note}</p></article>
      </div>
      <p style="text-align:center;margin-top:1.5rem"><a class="btn btn-primary" href="/precios">Ver todos los detalles</a></p>
    </div>
  </section>

  <section>
    <div class="narrow">
      <div class="sec-head reveal"><span class="eyebrow">Dudas</span><h2>Preguntas frecuentes</h2></div>
      {FAQ.slice(0, 5).map((f) => <details class="reveal"><summary>{f.q}</summary><div class="ans">{f.a}</div></details>)}
      <p style="text-align:center"><a href="/faq">Ver todas las preguntas →</a></p>
    </div>
  </section>

  <div class="wrap">
    <div class="cta-band reveal">
      <h2>¿Cuál es tu mejor jugada ahora mismo?</h2>
      <p class="muted">Coloca tu posición y descúbrelo en segundos. Sin registro y sin instalar nada.</p>
      <a class="btn btn-primary" href="/analizador">Abrir el analizador</a>
    </div>
  </div>
</Base>
