---
import Base from '../layouts/Base.astro';
import { PORTAL_URL, FREE_ANALYSES_PER_DAY, TRAINING, SUPPORT_URL } from '../config';
---
<Base title="Mi plan" description="Consulta tu plan de NextGranMaestro." noindex={true} crumbs={[{ name: 'Mi plan', href: '/cuenta' }]}>
  <div class="page-head narrow"><h1>Mi plan</h1></div>
  <div class="narrow" style="padding-bottom:3rem">
    <section id="acc-guest" hidden class="card" style="margin-bottom:1rem">
      <h2 class="h2s">Cuenta gratuita</h2>
      <p class="muted">No la necesitas para analizar, entrenar ni jugar. Con una cuenta guardas tu progreso y tus bots superados entre dispositivos, y tu plan queda a salvo si cambias de móvil.</p>
      <div class="row"><a class="btn btn-primary btn-sm" href="/entrar?crear=1&next=/cuenta">Crear cuenta</a><a class="btn btn-sm" href="/entrar?next=/cuenta">Entrar</a></div>
    </section>

    <section id="acc" hidden class="card" style="margin-bottom:1rem">
      <h2 class="h2s">Mi cuenta</h2>
      <p>Sesión iniciada como <strong id="acc-mail"></strong>.</p>
      <p class="notice" id="acc-verify" hidden><strong>Confirma tu email.</strong> Te hemos enviado un enlace. Hasta que lo abras no podrás comprar ni guardar un plan. <button class="btn btn-sm" id="btn-resend" type="button">Reenviar correo</button></p>
      <p class="muted small" id="acc-plan"></p>
      <div class="row">
        <button class="btn btn-primary btn-sm" id="btn-restore" type="button" hidden>Activar mi plan en este dispositivo</button>
        <button class="btn btn-primary btn-sm" id="btn-link" type="button" hidden>Guardar mi plan en la cuenta</button>
        <button class="btn btn-sm" id="btn-out" type="button">Cerrar sesión</button>
        <button class="btn btn-sm" id="btn-export" type="button">Descargar mis datos</button>
      </div>
      <p class="ok small" id="acc-ok" role="status" hidden></p>
      <p class="err small" id="acc-err" role="alert" hidden></p>
      <details class="det"><summary>Cambiar contraseña</summary>
        <form id="f-pw" novalidate>
          <label for="pw-old" class="lbl">Contraseña actual</label><input id="pw-old" type="password" autocomplete="current-password" required />
          <label for="pw-new" class="lbl">Contraseña nueva (mínimo 8 caracteres)</label><input id="pw-new" type="password" autocomplete="new-password" minlength="8" required />
          <div class="row"><button class="btn btn-sm" type="submit">Cambiar contraseña</button></div>
        </form>
      </details>
      <details class="det"><summary>Eliminar mi cuenta</summary>
        <p class="muted small">Se borran tu email, tu contraseña y tu progreso guardado. <strong>No cancela tu suscripción</strong>: para eso usa el enlace de gestión de Stripe.</p>
        <form id="f-del" novalidate>
          <label for="del-pw" class="lbl">Escribe tu contraseña para confirmar</label><input id="del-pw" type="password" autocomplete="current-password" required />
          <div class="row"><button class="btn btn-sm btn-danger" type="submit">Eliminar cuenta para siempre</button></div>
        </form>
      </details>
    </section>

    <section id="loading" class="card" aria-live="polite"><p class="muted">Comprobando tu plan…</p></section>

    <section id="on" hidden class="card plan-card">
      <p class="badge">♛ <span id="plan-name">Plan ilimitado</span></p>
      <h2 class="h2s">Tu plan está activo en este dispositivo</h2>
      <ul class="ticks">
        <li>Análisis ilimitados y profundidad «Máximo».</li>
        <li>Entrenamiento: hasta <strong>{TRAINING.premiumPerDay}</strong> niveles nuevos al día.</li>
        <li>Todos los bots para jugar, hasta el motor a plena potencia.</li>
        <li>Sin avisos de compra.</li>
      </ul>
      <p class="muted small">Un plan funciona en un dispositivo a la vez. ¿Cambias de móvil u ordenador? Usa <a href="/traspasar">Traspasar plan</a>.</p>
      <div class="row">
        <a class="btn btn-primary btn-sm" href="/analizador">Analizar</a>
        <a class="btn btn-sm" href="/entrenamiento">Entrenar</a>
        <a class="btn btn-sm" href="/traspasar">Traspasar plan</a>
        {PORTAL_URL ? <a class="btn btn-sm" href={PORTAL_URL} rel="noopener">Gestionar o cancelar suscripción</a> : null}
      </div>
      <p class="muted small">¿Algún problema con tu plan? <a href={SUPPORT_URL} rel="noopener noreferrer" target="_blank">Escríbenos en el soporte de Discord</a>.</p>
      {!PORTAL_URL && <p class="muted small">Para cancelar, usa el enlace de gestión que Stripe te envía en el recibo de pago.</p>}
    </section>

    <section id="off" hidden class="card">
      <p id="moved" class="notice" hidden><strong>Tu plan se ha activado en otro dispositivo.</strong> Un plan solo funciona en un dispositivo a la vez. Si quieres volver a usarlo aquí, entra en Traspasar plan con tu código.</p>
      <h2 class="h2s">Plan gratuito</h2>
      <ul class="ticks">
        <li>{FREE_ANALYSES_PER_DAY} análisis al día.</li>
        <li>Entrenamiento: {TRAINING.freePerDay} niveles nuevos al día.</li>
        <li>Bots gratis para jugar, con 3 pistas por partida.</li>
      </ul>
      <div class="row">
        <a class="btn btn-primary btn-sm" href="/precios">Ver el plan ilimitado</a>
        <a class="btn btn-sm" href="/traspasar">Ya tengo plan: traspasarlo aquí</a>
      </div>
    </section>
  </div>
</Base>
<style>
  .h2s{font-size:1.35rem;margin-top:.4rem}
  .row{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}
  .small{font-size:.85rem}
  .badge{display:inline-block;margin:0;padding:.25rem .7rem;border-radius:999px;background:rgba(214,176,92,.14);color:#e9cd8a;font-weight:700;font-size:.85rem}
  .ticks{margin:.8rem 0;padding-left:1.2rem}.ticks li{margin:.3rem 0}
  .lbl{display:block;font-weight:600;font-size:.9rem;margin:1rem 0 .4rem}
  input[type=password]{width:100%;min-height:46px;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:.6rem .8rem;font:inherit}
  .det{margin-top:1rem;border-top:1px solid var(--line);padding-top:.8rem}.det summary{cursor:pointer;font-weight:600;min-height:44px;display:flex;align-items:center}
  .btn-danger{border-color:#ff6b6b;color:#ffb3b3}
  .err{color:#ffb3b3}.ok{color:#9be6a8}
</style>
<script>
  import { getToken, refreshPremium, getPlan, planLabel, consumeMoved, isPremium } from '../utils/premium';
  import { cachedUser, me, logout, linkLocalPlan, restorePlan, changePassword, deleteAccount, syncNow, resendVerify, needsVerify } from '../utils/account';
  const $ = (id: string) => document.getElementById(id)!;
  (async () => {
    const had = !!getToken();
    const active = had ? await refreshPremium(true) : false;
    $('loading').hidden = true;
    $('on').hidden = !active; $('off').hidden = active;
    if (active) $('plan-name').textContent = planLabel(getPlan());
    else $('moved').hidden = !consumeMoved();
  })();

  // ---- Cuenta
  const ok = (m: string) => { $('acc-err').hidden = true; $('acc-ok').textContent = m; $('acc-ok').hidden = false; };
  const bad = (m: string) => { $('acc-ok').hidden = true; $('acc-err').textContent = m; $('acc-err').hidden = false; };
  const E: Record<string, string> = { bad_credentials: 'La contraseña no es correcta.', weak_password: 'La contraseña nueva debe tener entre 8 y 128 caracteres.', locked: 'Demasiados intentos fallidos. Espera unos minutos.', email_not_verified: 'Confirma primero tu email.', already_linked: 'Ese plan ya está guardado en otra cuenta.', network: 'No hay conexión con el servidor.' };
  async function paintAccount() {
    const u = cachedUser() ? await me() : null;
    $('acc-guest').hidden = !!u; $('acc').hidden = !u; if (!u) return;
    $('acc-mail').textContent = u.email; $('acc-verify').hidden = !needsVerify(u);
    const prem = isPremium();
    ($('btn-link') as HTMLElement).hidden = !(prem && !u.linked);
    ($('btn-restore') as HTMLElement).hidden = !(u.linked && !prem);
    $('acc-plan').textContent = u.linked ? (prem ? 'Tu plan está guardado en tu cuenta y activo en este dispositivo.' : 'Tu plan está guardado en tu cuenta. Puedes activarlo en este dispositivo (solo funciona en uno a la vez).') : (prem ? 'Tu plan no está en tu cuenta todavía: guárdalo para poder recuperarlo si cambias de dispositivo.' : 'Aún no tienes ningún plan en tu cuenta.');
  }
  paintAccount();
  $('btn-resend').addEventListener('click', async () => { const r = await resendVerify(); r.ok ? ok(r.already ? 'Tu email ya está confirmado.' : 'Correo enviado. Mira también el correo no deseado.') : bad(r.error === 'rate_limited' ? 'Espera unos minutos antes de pedir otro correo.' : 'No se pudo enviar el correo ahora mismo.'); });
  $('btn-out').addEventListener('click', async () => { await logout(); location.href = '/'; });
  $('btn-link').addEventListener('click', async () => { const r = await linkLocalPlan(); r ? (ok('Plan guardado en tu cuenta.'), paintAccount()) : bad('No se pudo guardar el plan. Si ya está en otra cuenta, escríbenos desde Soporte.'); });
  $('btn-restore').addEventListener('click', async () => {
    const r = await restorePlan();
    if (r.result === 'ok') { ok('Plan activado en este dispositivo.'); await refreshPremium(true); setTimeout(() => location.reload(), 900); }
    else if (r.result === 'wait') bad(`Tu plan está activo en otro dispositivo. Podrás pasarlo aquí dentro de unas ${r.waitHours} horas.`);
    else if (r.result === 'none') bad('Tu suscripción ya no está activa.'); else bad('No se pudo comprobar ahora mismo. Inténtalo de nuevo.');
  });
  $('btn-export').addEventListener('click', async () => {
    await syncNow(); const u = cachedUser(); const g = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
    const blob = new Blob([JSON.stringify({ email: u?.email, id: u?.id, exportado: new Date().toISOString(), entrenamiento: g('ngm-train'), bots: g('ngm-bots') }, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'mis-datos-nextgranmaestro.json'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 2000);
  });
  $('f-pw').addEventListener('submit', async (e) => { e.preventDefault(); const r = await changePassword(($('pw-old') as HTMLInputElement).value, ($('pw-new') as HTMLInputElement).value); if (r.ok) { ok('Contraseña cambiada. Se han cerrado las sesiones de otros dispositivos.'); ($('f-pw') as HTMLFormElement).reset(); } else bad(E[r.error || ''] || 'No se pudo cambiar la contraseña.'); });
  $('f-del').addEventListener('submit', async (e) => { e.preventDefault(); if (!confirm('¿Eliminar tu cuenta para siempre? No se puede deshacer.')) return; const r = await deleteAccount(($('del-pw') as HTMLInputElement).value); if (r.ok) location.href = '/'; else bad(E[r.error || ''] || 'No se pudo eliminar la cuenta.'); });
</script>
