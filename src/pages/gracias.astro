---
import Base from '../layouts/Base.astro';
import { PORTAL_URL } from '../config';
---
<Base title="Activando tu plan" description="Activación del plan ilimitado de NextGranMaestro." noindex={true}>
  <div class="narrow" style="text-align:center;padding-block:4rem">
    <div id="st-wait" aria-live="polite">
      <p style="font-size:3rem;margin:0" aria-hidden="true">⏳</p>
      <h1>Activando tu plan…</h1>
      <p class="muted">Estamos confirmando tu pago con Stripe. Tarda unos segundos.</p>
    </div>
    <div id="st-ok" hidden>
      <p style="font-size:3rem;margin:0" aria-hidden="true">♛</p>
      <h1>¡Plan ilimitado activado!</h1>
      <p class="muted">Gracias por apoyar NextGranMaestro. Ya puedes analizar sin límite en este navegador.</p>
      <p><a class="btn btn-primary" href="/analizador">Ir al analizador</a></p>
      <p class="muted small-note">El plan queda activado en este navegador. Para usarlo en otro dispositivo, entra en <a href="/cuenta">Mi plan</a>, copia tu código de activación y pégalo allí.{PORTAL_URL ? <span> Gestiona o cancela tu suscripción <a href={PORTAL_URL} rel="noopener">aquí</a>.</span> : null}</p>
    </div>
    <div id="st-err" hidden>
      <p style="font-size:3rem;margin:0" aria-hidden="true">⚠️</p>
      <h1>No hemos podido activar el plan</h1>
      <p id="st-msg" class="muted"></p>
      <p><a class="btn" href="/precios">Volver a precios</a></p>
    </div>
  </div>
</Base>
<style>.small-note{font-size:.85rem;max-width:52ch;margin:2rem auto 0}</style>
<script>
  import { setToken } from '../utils/premium';
  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string) => { ['st-wait', 'st-ok', 'st-err'].forEach((x) => ($(x).hidden = x !== id)); };
  const MSG: Record<string, string> = {
    not_paid: 'El pago aún no figura como completado. Espera un minuto y recarga esta página.',
    subscription_inactive: 'La suscripción no está activa.',
    session_not_found: 'No encontramos ese pago. Comprueba que has abierto el enlace completo.',
    invalid_session: 'El enlace no es válido. Si acabas de pagar, vuelve a abrir el enlace que te dio Stripe.',
    server_not_configured: 'El servidor de pagos aún no está configurado.',
  };
  (async () => {
    const id = new URLSearchParams(location.search).get('session_id');
    if (!id) { $('st-msg').textContent = MSG.invalid_session; show('st-err'); return; }
    try {
      const r = await fetch('/api/activate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ session_id: id }) });
      const j = await r.json();
      if (j.ok && j.token) { setToken(j.token); show('st-ok'); return; }
      $('st-msg').textContent = MSG[j.error] || 'Ha ocurrido un error. Escríbenos con tu comprobante de pago de Stripe y lo resolvemos.';
    } catch { $('st-msg').textContent = 'No hay conexión con el servidor. Recarga la página en unos segundos.'; }
    show('st-err');
  })();
</script>
