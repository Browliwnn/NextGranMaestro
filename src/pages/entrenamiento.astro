---
import Base from '../layouts/Base.astro';
import Trainer from '../components/Trainer.astro';
import puzzles from '../data/puzzles.json';
import { TRAINING } from '../config';
const n = puzzles.length;
---
<Base title="Entrenamiento de ajedrez — niveles diarios" description={`Entrena ajedrez con ${n} niveles de «encuentra la mejor jugada», de fácil a difícil, con soluciones comprobadas por Stockfish. Avanza un nivel al día gratis.`} crumbs={[{ name: 'Entrenamiento', href: '/entrenamiento' }]}>
  <div class="page-head wrap">
    <span class="eyebrow">Entrenamiento</span>
    <h1>Un nivel nuevo cada día</h1>
    <p class="muted" style="max-width:68ch">{n} ejercicios de «encuentra la mejor jugada», ordenados de menos a más difícil: primero mates en 1, luego tácticas y mates más largos. Cada solución está comprobada con Stockfish. Con el plan gratis superas {TRAINING.freePerDay} nivel nuevo al día; con el plan ilimitado, {TRAINING.premiumPerDay}.</p>
  </div>
  <div class="wrap" style="padding-bottom:3rem"><Trainer /></div>
</Base>
