---
import '../styles/board.css';
import { defsSvg } from '../utils/pieces';
import { TRAINING } from '../config';
import puzzles from '../data/puzzles.json';
const total = puzzles.length;
---
<Fragment set:html={defsSvg} />
<div class="tr" data-total={total} data-free={TRAINING.freePerDay} data-prem={TRAINING.premiumPerDay}>
  <div class="tr-board-col">
    <div class="tr-stage">
      <div class="frame">
        <div class="board-wrap">
          <div id="board" class="board" role="group" aria-label="Tablero del ejercicio"></div>
          <svg id="arrows" class="arrows" viewBox="0 0 800 800" aria-hidden="true"></svg>
          <div class="promo" id="promo" role="dialog" aria-modal="true" aria-label="Elige la pieza para coronar el peón" hidden></div>
        </div>
      </div>
    </div>
    <div class="tr-tools" role="group" aria-label="Controles del ejercicio">
      <button class="btn btn-sm" id="reset" type="button">↺ Reiniciar</button>
      <button class="btn btn-sm" id="hint" type="button">💡 Pista</button>
      <button class="btn btn-sm" id="solve" type="button">👁 Ver solución</button>
      <button class="btn btn-sm" id="sound" type="button" aria-pressed="true">🔊 Sonido</button>
    </div>
  </div>

  <div class="tr-panel">
    <div class="card">
      <p class="eyebrow" id="lvl-type">Nivel</p>
      <h2 class="h-sm" id="lvl-name">Cargando…</h2>
      <p class="turn" id="turn" aria-live="polite"></p>
      <p id="feedback" class="feedback" role="status" aria-live="polite">Encuentra la mejor jugada.</p>
      <p class="moves" id="line"></p>
      <div class="tr-actions">
        <button class="btn btn-primary" id="next" type="button" hidden>Siguiente nivel →</button>
      </div>
      <p class="muted small" id="gate" aria-live="polite"></p>
    </div>

    <div class="card" style="margin-top:1rem">
      <div class="tr-prog"><div class="bar" aria-hidden="true"><i id="barfill" style="width:0%"></i></div></div>
      <p class="small" id="prog">—</p>
      <p class="small" id="quota">—</p>
      <p class="small" id="streak"></p>
      <p class="muted small">Tu progreso se guarda en este dispositivo.</p>
    </div>

    <div class="card" style="margin-top:1rem">
      <h2 class="h-sm">Niveles</h2>
      <div class="map" id="map" role="group" aria-label="Mapa de niveles"></div>
    </div>
  </div>
</div>

<style is:global>
  .tr{display:grid;gap:1.5rem;align-items:start}
  @media (min-width:960px){.tr{grid-template-columns:minmax(0,1fr) 390px}}
  .tr-stage{width:min(100%,690px);margin-inline:auto}
  @media (min-width:1700px){.tr-stage{width:min(100%,780px)}.tr{grid-template-columns:minmax(0,1fr) 440px}}
  @media (max-height:520px) and (orientation:landscape){.tr-stage{width:min(100%,calc(100dvh - 90px))}}
  .tr-tools{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem;justify-content:center}
  .tr .h-sm{font-size:1.3rem;margin:.1rem 0 .3rem}
  .tr .turn{margin:0 0 .6rem;color:var(--muted)}
  .feedback{font-weight:600;margin:.4rem 0}
  .feedback.ok{color:#7be3a6}.feedback.bad{color:#ffb3b3}
  .tr .moves{margin:.5rem 0 0;font:500 .9rem/1.6 ui-monospace,Menlo,Consolas,monospace;color:var(--muted)}
  .tr .moves:empty{display:none}
  .tr-actions{margin-top:1rem}
  .tr .small{font-size:.9rem;margin:.4rem 0}
  .tr-prog .bar{height:10px;border-radius:99px;background:var(--bg);border:1px solid var(--line);overflow:hidden}
  .tr-prog .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),#ffd27a);transition:width .5s var(--ease)}
  .map{display:grid;grid-template-columns:repeat(auto-fill,minmax(42px,1fr));gap:6px;margin-top:.8rem}
  .map button{min-height:42px;border-radius:9px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:600 .85rem var(--font);cursor:pointer;position:relative}
  .map button:hover:not(:disabled){border-color:var(--gold)}
  .map button.done{background:rgba(61,220,151,.14);border-color:rgba(61,220,151,.5)}
  .map button.cur{background:rgba(214,176,92,.2);border-color:var(--gold);color:#ffe6a8}
  .map button.sel{outline:2px solid var(--gold);outline-offset:1px}
  .map button:disabled{opacity:.4;cursor:not-allowed}
  .tr .board.shake{animation:shake .35s}
  @keyframes shake{20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}
  @media (prefers-reduced-motion:reduce){.tr .board.shake{animation:none}}
</style>

<script>
  import { Chess } from 'chess.js';
  import type { Square } from 'chess.js';
  import PUZZLES from '../data/puzzles.json';
  import { pieceSvg } from '../utils/pieces';
  import { arrowSvg } from '../utils/arrows';
  import { isPremium, refreshPremium } from '../utils/premium';
  import { sfx, sound } from '../utils/sfx';
  import { load, complete, currentLevel, type TrainState } from '../utils/training';
  import { syncNow } from '../utils/account';

  type Puzzle = { f: string; m: string; pv: string; t: string };
  const P = PUZZLES as Puzzle[];
  const TOTAL = P.length;
  const root = document.querySelector<HTMLElement>('.tr')!;
  const FREE = Number(root.dataset.free || 1); const PREM = Number(root.dataset.prem || 5);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const boardEl = $('board'); const arrowsEl = document.getElementById('arrows') as unknown as SVGSVGElement;
  const pieceName: Record<string, string> = { k: 'rey', q: 'dama', r: 'torre', b: 'alfil', n: 'caballo', p: 'peón' };
  const ES: Record<string, string> = { N: 'C', B: 'A', R: 'T', Q: 'D', K: 'R' };
  const es = (san: string) => san.replace(/^[NBRQK]/, (m) => ES[m]).replace(/=([NBRQ])/, (_, p) => '=' + ES[p]);
  const TYPE: Record<string, string> = { m1: 'Mate en 1', m2: 'Mate en 2', m3: 'Mate en 3', w: 'Táctica' };
  const files = 'abcdefgh';

  let st: TrainState = load();
  let level = 1; let game = new Chess(); let flipped = false;
  let selected: Square | null = null; let last: { from: string; to: string } | null = null;
  let solved = false; let busy = false; let fails = 0; let hintSq: string | null = null; let revealed = false;
  let timers: number[] = [];

  const perDay = () => (isPremium() ? PREM : FREE);
  const quotaLeft = () => Math.max(0, perDay() - st.today);
  const cur = () => currentLevel(st, TOTAL);
  const later = (fn: () => void, ms: number) => { timers.push(window.setTimeout(fn, ms)); };
  const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

  function squares(): Square[] {
    const out: Square[] = [];
    for (let r = 0; r < 8; r++) for (let f = 0; f < 8; f++) {
      const file = flipped ? 7 - f : f; const rank = flipped ? r : 7 - r;
      out.push((files[file] + (rank + 1)) as Square);
    }
    return out;
  }
  function kingSquare(color: 'w' | 'b'): string | null {
    for (const row of game.board()) for (const p of row) if (p && p.type === 'k' && p.color === color) return p.square;
    return null;
  }
  function render(popSq?: string, arrow?: { from: string; to: string }) {
    const legal = new Map<string, boolean>();
    if (selected) game.moves({ square: selected, verbose: true }).forEach((m) => legal.set(m.to, !!m.captured || m.flags.includes('e')));
    const chkSq = game.inCheck() ? kingSquare(game.turn()) : null;
    boardEl.innerHTML = '';
    squares().forEach((sq, i) => {
      const file = files.indexOf(sq[0]); const rank = Number(sq[1]) - 1;
      const dark = (file + rank) % 2 === 0; const piece = game.get(sq);
      const b = document.createElement('button'); b.type = 'button'; b.dataset.sq = sq;
      let cls = 'sq' + (dark ? ' dark' : '');
      if (last && (last.from === sq || last.to === sq)) cls += ' last';
      if (selected === sq) cls += ' sel';
      if (chkSq === sq) cls += ' chk';
      if (hintSq === sq) cls += ' hint';
      if (legal.has(sq)) cls += ' dot' + (legal.get(sq) ? ' cap' : '');
      if (popSq === sq) cls += ' pop';
      b.className = cls;
      b.setAttribute('aria-label', `${sq}${piece ? ', ' + pieceName[piece.type] + (piece.color === 'w' ? ' blanco' : ' negro') : ', vacía'}`);
      const tn = dark ? 'dk' : 'lt';
      b.innerHTML = (piece ? pieceSvg(piece.color, piece.type) : '') +
        ((i % 8 === 7) ? `<span class="co r ${tn}" aria-hidden="true">${sq[1]}</span>` : '') +
        ((i >= 56) ? `<span class="co f ${tn}" aria-hidden="true">${sq[0]}</span>` : '');
      boardEl.appendChild(b);
    });
    arrowsEl.innerHTML = arrow ? arrowSvg(arrow.from, arrow.to, '#3ddc97', 18, 0.95, flipped) : '';
  }

  function lineText(p: Puzzle, from = 0, max = 8): string {
    const g = new Chess(p.f); const out: string[] = []; const parts = p.f.split(' ');
    let white = parts[1] === 'w'; let num = Number(parts[5]) || 1;
    const uci = p.pv.split(' ').slice(0, max);
    for (let i = 0; i < uci.length; i++) {
      let mv; try { mv = g.move({ from: uci[i].slice(0, 2) as Square, to: uci[i].slice(2, 4) as Square, promotion: uci[i][4] }); } catch { break; }
      if (i >= from) out.push((white ? `${num}. ` : (out.length === 0 ? `${num}… ` : '')) + es(mv.san));
      if (!white) num++; white = !white;
    }
    return out.join(' ');
  }

  function say(msg: string, cls: '' | 'ok' | 'bad' = '') { const f = $('feedback'); f.textContent = msg; f.className = 'feedback ' + cls; }

  function status(n: number): 'done' | 'cur' | 'locked' | 'open' {
    if (st.done.includes(n)) return 'done';
    return n === cur() ? 'cur' : 'locked';
  }

  function paintMap() {
    const m = $('map'); m.innerHTML = '';
    for (let n = 1; n <= TOTAL; n++) {
      const s = status(n);
      const b = document.createElement('button'); b.type = 'button'; b.dataset.n = String(n);
      b.className = (s === 'done' ? 'done' : s === 'cur' ? 'cur' : '') + (n === level ? ' sel' : '');
      b.disabled = s === 'locked';
      b.setAttribute('aria-label', `Nivel ${n}${s === 'done' ? ', superado' : s === 'cur' ? ', nivel actual' : ', bloqueado'}`);
      b.textContent = s === 'done' ? '✓' : String(n);
      if (s === 'done') b.title = `Nivel ${n}`;
      m.appendChild(b);
    }
  }

  function paintStatus() {
    const done = st.done.length;
    $('barfill').style.width = (TOTAL ? (done / TOTAL) * 100 : 0) + '%';
    $('prog').innerHTML = `Niveles superados: <strong>${done}</strong> de ${TOTAL}`;
    const left = quotaLeft(); const pd = perDay();
    $('quota').innerHTML = `Hoy: <strong>${Math.min(st.today, pd)}</strong> de ${pd} niveles nuevos superados` + (isPremium() ? ' · plan ilimitado ♛' : ` · <a href="/precios">con el plan ilimitado, ${PREM} al día</a>`);
    $('streak').textContent = st.streak > 0 ? `🔥 Racha: ${st.streak} ${st.streak === 1 ? 'día' : 'días'} seguidos` : '';
    paintMap();
    const c = cur();
    const gate = $('gate');
    if (c > TOTAL) gate.textContent = '🏆 ¡Has superado todos los niveles! Puedes repetir cualquiera.';
    else if (left <= 0) gate.innerHTML = `Hoy ya has superado tus ${pd} ${pd === 1 ? 'nivel' : 'niveles'} nuevos. Vuelve mañana para el siguiente${isPremium() ? '' : ' o <a href="/precios">consigue ' + PREM + ' al día con el plan ilimitado</a>'}.`;
    else gate.textContent = '';
  }

  function loadLevel(n: number) {
    clearTimers();
    if (n < 1 || n > TOTAL) return;
    level = n; const p = P[n - 1];
    game = new Chess(p.f); flipped = game.turn() === 'b';
    selected = null; last = null; solved = false; busy = false; fails = 0; hintSq = null; revealed = false;
    $('lvl-type').textContent = `${TYPE[p.t] || 'Táctica'} · nivel ${n} de ${TOTAL}`;
    $('lvl-name').textContent = p.t[0] === 'm' ? `Da jaque mate en ${p.t[1]}` : 'Encuentra la mejor jugada';
    $('turn').textContent = `Juegan ${game.turn() === 'w' ? 'las blancas' : 'las negras'}.`;
    $('line').textContent = '';
    ($('next') as HTMLElement).hidden = true;
    const playable = st.done.includes(n) || (n === cur() && quotaLeft() > 0);
    say(playable ? (st.done.includes(n) ? 'Nivel ya superado: repítelo cuando quieras.' : 'Encuentra la mejor jugada.') : 'Vuelve mañana para jugar este nivel.');
    render(); paintStatus();
  }
  const canPlay = () => st.done.includes(level) || (level === cur() && quotaLeft() > 0);

  // ---- Jugar ----
  const promoEl = $('promo');
  function closePromo() { promoEl.hidden = true; promoEl.innerHTML = ''; }
  function askPromotion(from: Square, to: Square, color: 'w' | 'b') {
    const names: Record<string, string> = { q: 'Dama', r: 'Torre', b: 'Alfil', n: 'Caballo' };
    promoEl.innerHTML = '<div class="opts">' + (['q', 'r', 'b', 'n'] as const).map((t) => `<button type="button" data-p="${t}" aria-label="${names[t]}">${pieceSvg(color, t)}</button>`).join('') + '</div>';
    promoEl.hidden = false; promoEl.querySelector<HTMLButtonElement>('button')!.focus();
    promoEl.onclick = (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-p]');
      if (btn) { closePromo(); attempt(from, to, btn.dataset.p as 'q' | 'r' | 'b' | 'n'); }
      else if (e.target === promoEl) { closePromo(); selected = null; render(); }
    };
  }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !promoEl.hidden) { closePromo(); selected = null; render(); } });

  function attempt(from: Square, to: Square, promo?: 'q' | 'r' | 'b' | 'n') {
    const opts = game.moves({ square: from, verbose: true }).filter((m) => m.to === to);
    if (!opts.length) return false;
    if (opts[0].promotion && !promo) { askPromotion(from, to, game.turn()); return true; }
    const p = P[level - 1]; const uci = from + to + (promo || '');
    let mv; try { mv = game.move({ from, to, promotion: promo }); } catch { return false; }
    last = { from: mv.from, to: mv.to }; selected = null; hintSq = null;
    mv.captured ? sfx.capture() : sfx.move(); if (game.inCheck()) later(sfx.check, 120);
    render(mv.to);
    if (uci === p.m) { onSolved(p); }
    else {
      fails++; busy = true; sfx.error(); boardEl.classList.add('shake');
      say(fails >= 2 ? 'Esa no es. Prueba con «Pista» o mira «Ver solución».' : 'Esa no es la mejor jugada. Inténtalo otra vez.', 'bad');
      later(() => { boardEl.classList.remove('shake'); game.undo(); const h = game.history({ verbose: true }); const l = h[h.length - 1]; last = l ? { from: l.from, to: l.to } : null; busy = false; render(); }, 850);
    }
    return true;
  }

  function onSolved(p: Puzzle) {
    solved = true; busy = true;
    const first = !st.done.includes(level) && level === cur() && quotaLeft() > 0;
    const uci = p.pv.split(' ');
    let i = 1;
    const step = () => {
      if (i >= Math.min(uci.length, 6)) return finish();
      const u = uci[i++];
      try { const mv = game.move({ from: u.slice(0, 2) as Square, to: u.slice(2, 4) as Square, promotion: u[4] }); last = { from: mv.from, to: mv.to }; mv.captured ? sfx.capture() : sfx.move(); render(mv.to); } catch { return finish(); }
      later(step, 650);
    };
    const finish = () => {
      busy = false;
      $('line').textContent = 'Línea: ' + lineText(p);
      if (first) { st = complete(st, level); sfx.win(); say(p.t[0] === 'm' ? '¡Jaque mate! Nivel superado.' : '¡Correcto! Nivel superado.', 'ok'); }
      else { sfx.done(); say('¡Correcto!', 'ok'); }
      paintStatus();
      const nx = cur();
      const nextBtn = $('next') as HTMLButtonElement;
      nextBtn.hidden = false;
      if (st.done.includes(level) && nx <= TOTAL && quotaLeft() > 0) { nextBtn.textContent = 'Siguiente nivel →'; nextBtn.disabled = false; nextBtn.dataset.go = String(nx); }
      else if (nx > TOTAL) { nextBtn.hidden = true; }
      else { nextBtn.textContent = 'Siguiente nivel (mañana)'; nextBtn.disabled = true; delete nextBtn.dataset.go; }
    };
    later(step, 500);
  }

  boardEl.addEventListener('click', (e) => {
    if (busy || solved || !canPlay()) { if (!canPlay() && !solved) say('Este nivel no está disponible hoy.', 'bad'); return; }
    const t = (e.target as HTMLElement).closest<HTMLElement>('.sq'); if (!t) return;
    const sq = t.dataset.sq as Square;
    if (selected && selected !== sq && attempt(selected, sq)) return;
    const p = game.get(sq);
    selected = p && p.color === game.turn() && selected !== sq ? sq : null;
    render();
  });

  $('map').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-n]'); if (b && !b.disabled) loadLevel(Number(b.dataset.n)); });
  $('next').addEventListener('click', () => { const g = Number(($('next') as HTMLElement).dataset.go); if (g) loadLevel(g); });
  $('reset').addEventListener('click', () => loadLevel(level));
  $('hint').addEventListener('click', () => { if (busy || solved || !canPlay()) return; hintSq = P[level - 1].m.slice(0, 2); render(); say('La pieza de la casilla marcada es la que debes mover.'); });
  $('solve').addEventListener('click', () => {
    if (busy || solved) return; const p = P[level - 1];
    revealed = true; hintSq = null; render(undefined, { from: p.m.slice(0, 2), to: p.m.slice(2, 4) });
    say(canPlay() ? 'Esta es la jugada. Pruébala tú para superar el nivel.' : 'Esta es la jugada.');
    $('line').textContent = 'Línea: ' + lineText(p);
  });
  function syncSound() { const b = $('sound'); b.textContent = sound.on ? '🔊 Sonido' : '🔇 Sin sonido'; b.setAttribute('aria-pressed', String(sound.on)); }
  $('sound').addEventListener('click', () => { sound.set(!sound.on); syncSound(); sfx.move(); });

  syncSound();
  const c0 = cur(); loadLevel(c0 > TOTAL ? TOTAL : c0);
  refreshPremium().then(() => { st = load(); paintStatus(); });
  syncNow().then((c) => { if (c) { st = load(); const nx = cur(); if (!solved && !busy && level !== nx && !st.done.includes(level)) loadLevel(nx > TOTAL ? TOTAL : nx); else paintStatus(); } });
</script>
