---
import { SITE_NAME, SITE_TAGLINE, SUPPORT_URL } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p><strong>{SITE_NAME}</strong></p>
        <p class="muted">{SITE_TAGLINE}.</p>
      </div>
      <nav aria-label="Producto">
        <h2>Producto</h2>
        <ul>
          <li><a href="/analizador">Analizador</a></li>
          <li><a href="/como-funciona">Cómo funciona</a></li>
          <li><a href="/precios">Precios</a></li>
          <li><a href="/entrenamiento">Entrenamiento</a></li>
          <li><a href="/faq">Preguntas frecuentes</a></li>
          <li><a href="/buscar">Buscar</a></li>
          <li><a href="/cuenta">Mi plan</a></li>
          <li><a href="/traspasar">Traspasar plan</a></li>
          <li><a href="/soporte">Atención al cliente</a></li>
          <li><a href={SUPPORT_URL} rel="noopener noreferrer" target="_blank">Soporte en Discord <span class="sr-only">(se abre en una pestaña nueva)</span></a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacidad">Política de privacidad</a></li>
          <li><a href="/cookies">Política de cookies</a></li>
          <li><a href="/aviso-legal">Aviso legal</a></li>
          <li><a href="/condiciones">Condiciones de contratación</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">© {year} {SITE_NAME}. Motor de análisis: Stockfish (licencia GPLv3). No afiliado a Chess.com, Lichess ni FIDE. Úsalo respetando las normas de juego limpio de cada plataforma y torneo.</p>
  </div>
</footer>
