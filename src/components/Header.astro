---
import { NAV, SITE_NAME } from '../config';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE_NAME} — inicio`}><Logo /><span>Next<b>Gran</b>Maestro</span></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav" aria-label="Abrir menú">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav id="nav" class="nav" aria-label="Principal">
      {NAV.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      <a class="nav-search" href="/buscar" aria-label="Buscar en la web" title="Buscar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a>
      <a class="nav-user" href="/entrar" id="nav-user" title="Entrar o crear cuenta"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg><span class="sr-only" id="nav-user-t">Entrar o crear cuenta</span></a>
      <a class="btn btn-primary btn-sm" href="/precios" data-free-only>Plan ilimitado</a>
      <a class="plan-chip" href="/cuenta" id="plan-chip" data-prem-only title="Tu plan"><span aria-hidden="true">♛</span> <span id="plan-chip-t">Plan ilimitado</span></a>
    </nav>
  </div>
</header>
<script>
  import { isPremium, refreshPremium, getPlan, planLabel } from '../utils/premium';
  import { cachedUser, me, syncIfStale } from '../utils/account';
  const paintPlan = () => {
    const on = isPremium();
    if (on) { document.documentElement.setAttribute('data-prem', getPlan()); const t = document.getElementById('plan-chip-t'); if (t) t.textContent = planLabel(getPlan()); }
    else document.documentElement.removeAttribute('data-prem');
  };
  const paintUser = () => {
    const u = cachedUser(); const a = document.getElementById('nav-user') as HTMLAnchorElement | null; if (!a) return;
    a.href = u ? '/cuenta' : '/entrar'; a.title = u ? `Mi cuenta (${u.email})` : 'Entrar o crear cuenta';
    const t = document.getElementById('nav-user-t'); if (t) t.textContent = u ? 'Mi cuenta' : 'Entrar o crear cuenta';
    a.classList.toggle('on', !!u);
  };
  paintUser();
  paintPlan();
  refreshPremium().then(paintPlan);
  if (cachedUser()) me().then(() => { paintUser(); syncIfStale(); });
  const b = document.querySelector('.menu-btn');
  const n = document.getElementById('nav');
  b?.addEventListener('click', () => {
    const o = n!.classList.toggle('open');
    b.setAttribute('aria-expanded', String(o));
    b.setAttribute('aria-label', o ? 'Cerrar menú' : 'Abrir menú');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && n!.classList.contains('open')) { n!.classList.remove('open'); b?.setAttribute('aria-expanded', 'false'); (b as HTMLElement).focus(); }
  });
</script>
